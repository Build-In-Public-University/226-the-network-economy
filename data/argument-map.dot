digraph claims {
  graph [rankdir=LR];
  D1 [label="D1: Capitalism is contested and definitionally plural"];
  M1 [label="M1: Marx: accumulation depends on wage labor and private control"];
  W1 [label="W1: Weber: capitalist durability is culturally motivated"];
  S1 [label="S1: Schumpeter: entrepreneurship drives creative destruction"];
  H1 [label="H1: Hayek/Friedman: free markets and property yield efficiency"];
  I1 [label="I1: Institutions constitute markets rather than merely constrain them"];
  P1 [label="P1: Polanyi: land, labor, and money are fictitious commodities"];
  K1 [label="K1: Keynes: investment depends on uncertain expectations and liquidity preference"];
  WEL1 [label="WEL1: Markets can raise welfare and benefit the worst off"];
  EFF1 [label="EFF1: Markets process dispersed information more effectively than planners"];
  FRE1 [label="FRE1: Market exchange is voluntary and protects negative liberty"];
  POL1 [label="POL1: Economic freedom disperses political power"];
  X1 [label="X1: Capitalism exploits labor through surplus extraction"];
  X2 [label="X2: Capitalism structurally dominates workers or producers"];
  X3 [label="X3: Capitalism commodifies and destabilizes social reproduction/nature"];
  R1 [label="R1: Capitalism has endogenous crisis or self-undermining tendencies"];
  R2 [label="R2: Welfare-state capitalism cannot secure justice"];
  N1 [label="N1: Critiques must establish distinctiveness, causality, systematicity, and perhaps non-contingency"];
  D1 -> M1 [style=solid, color=darkgreen, label="supports"];
  D1 -> I1 [style=solid, color=darkgreen, label="supports"];
  D1 -> P1 [style=solid, color=darkgreen, label="supports"];
  M1 -> X1 [style=solid, color=darkgreen, label="supports"];
  M1 -> X2 [style=solid, color=darkgreen, label="supports"];
  M1 -> X3 [style=solid, color=darkgreen, label="supports"];
  M1 -> H1 [style=dashed, color=firebrick, label="challenges"];
  M1 -> I1 [style=dashed, color=firebrick, label="challenges"];
  M1 -> R1 [style=dashed, color=firebrick, label="challenges"];
  W1 -> X2 [style=solid, color=darkgreen, label="supports"];
  W1 -> M1 [style=dashed, color=firebrick, label="challenges"];
  W1 -> S1 [style=dashed, color=firebrick, label="challenges"];
  S1 -> X2 [style=solid, color=darkgreen, label="supports"];
  S1 -> X3 [style=solid, color=darkgreen, label="supports"];
  S1 -> M1 [style=dashed, color=firebrick, label="challenges"];
  H1 -> WEL1 [style=solid, color=darkgreen, label="supports"];
  H1 -> EFF1 [style=solid, color=darkgreen, label="supports"];
  H1 -> FRE1 [style=solid, color=darkgreen, label="supports"];
  H1 -> POL1 [style=solid, color=darkgreen, label="supports"];
  H1 -> M1 [style=dashed, color=firebrick, label="challenges"];
  H1 -> P1 [style=dashed, color=firebrick, label="challenges"];
  H1 -> X1 [style=dashed, color=firebrick, label="challenges"];
  I1 -> H1 [style=solid, color=darkgreen, label="supports"];
  I1 -> P1 [style=solid, color=darkgreen, label="supports"];
  P1 -> I1 [style=solid, color=darkgreen, label="supports"];
  P1 -> X3 [style=solid, color=darkgreen, label="supports"];
  P1 -> R2 [style=solid, color=darkgreen, label="supports"];
  P1 -> H1 [style=dashed, color=firebrick, label="challenges"];
  P1 -> D1 [style=dashed, color=firebrick, label="challenges"];
  K1 -> R1 [style=solid, color=darkgreen, label="supports"];
  K1 -> EFF1 [style=solid, color=darkgreen, label="supports"];
  K1 -> H1 [style=dashed, color=firebrick, label="challenges"];
  WEL1 -> H1 [style=solid, color=darkgreen, label="supports"];
  WEL1 -> EFF1 [style=solid, color=darkgreen, label="supports"];
  WEL1 -> R2 [style=dashed, color=firebrick, label="challenges"];
  WEL1 -> X2 [style=dashed, color=firebrick, label="challenges"];
  EFF1 -> H1 [style=solid, color=darkgreen, label="supports"];
  EFF1 -> P1 [style=dashed, color=firebrick, label="challenges"];
  EFF1 -> R2 [style=dashed, color=firebrick, label="challenges"];
  FRE1 -> H1 [style=solid, color=darkgreen, label="supports"];
  FRE1 -> POL1 [style=solid, color=darkgreen, label="supports"];
  FRE1 -> X1 [style=dashed, color=firebrick, label="challenges"];
  FRE1 -> X2 [style=dashed, color=firebrick, label="challenges"];
  POL1 -> FRE1 [style=solid, color=darkgreen, label="supports"];
  POL1 -> R2 [style=dashed, color=firebrick, label="challenges"];
  POL1 -> X2 [style=dashed, color=firebrick, label="challenges"];
  X1 -> M1 [style=solid, color=darkgreen, label="supports"];
  X1 -> X2 [style=solid, color=darkgreen, label="supports"];
  X1 -> X3 [style=solid, color=darkgreen, label="supports"];
  X1 -> H1 [style=dashed, color=firebrick, label="challenges"];
  X1 -> N1 [style=dashed, color=firebrick, label="challenges"];
  X2 -> X1 [style=solid, color=darkgreen, label="supports"];
  X2 -> R2 [style=solid, color=darkgreen, label="supports"];
  X2 -> H1 [style=dashed, color=firebrick, label="challenges"];
  X2 -> N1 [style=dashed, color=firebrick, label="challenges"];
  X3 -> M1 [style=solid, color=darkgreen, label="supports"];
  X3 -> P1 [style=solid, color=darkgreen, label="supports"];
  X3 -> H1 [style=dashed, color=firebrick, label="challenges"];
  X3 -> N1 [style=dashed, color=firebrick, label="challenges"];
  R1 -> M1 [style=solid, color=darkgreen, label="supports"];
  R1 -> K1 [style=solid, color=darkgreen, label="supports"];
  R1 -> X3 [style=solid, color=darkgreen, label="supports"];
  R1 -> H1 [style=dashed, color=firebrick, label="challenges"];
  R2 -> X2 [style=solid, color=darkgreen, label="supports"];
  R2 -> POL1 [style=solid, color=darkgreen, label="supports"];
  R2 -> WEL1 [style=dashed, color=firebrick, label="challenges"];
  R2 -> H1 [style=dashed, color=firebrick, label="challenges"];
  R2 -> N1 [style=dashed, color=firebrick, label="challenges"];
  N1 -> R1 [style=solid, color=darkgreen, label="supports"];
  N1 -> R2 [style=solid, color=darkgreen, label="supports"];
  N1 -> X1 [style=solid, color=darkgreen, label="supports"];
  N1 -> X2 [style=solid, color=darkgreen, label="supports"];
  N1 -> X3 [style=solid, color=darkgreen, label="supports"];
}
